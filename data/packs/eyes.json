[{"_id": "yzUrZJzahfIm4YoC", "name": "The Abominable Eye of Detestation", "type": "eye", "img": "icons/svg/eye.svg", "system": {"description": "<p>1d12 beings flee in horror; good against undead. Cornered victims fight at +2 needed to hit and -2 damage.</p><p>When found, the referee rolls d100 for charges; 5% of Eyes are defective (Sec. 1300).</p>", "source": "EPT 1975 Sec. 1310 no. 1", "cost": 0, "weight": 0, "quantity": 1, "charges": {"value": 0, "max": 100}, "dial": false, "identified": true, "inscription": "", "range": "40 ft", "duration": "1 turn", "targeting": "area", "save": "vs. Eyes", "damage": "", "rarity": ""}, "effects": [], "folder": null, "sort": 1, "ownership": {"default": 0}, "flags": {}, "_key": "!items!yzUrZJzahfIm4YoC"}, {"_id": "Pb5OgoGW7zPKLldE", "name": "The Excellent Ruby Eye", "type": "eye", "img": "icons/svg/eye.svg", "system": {"description": "<p>Freezes 1-6 beings in time. Another charge releases a victim. Fairly common.</p><p>When found, the referee rolls d100 for charges; 5% of Eyes are defective (Sec. 1300).</p>", "source": "EPT 1975 Sec. 1310 no. 2", "cost": 0, "weight": 0, "quantity": 1, "charges": {"value": 0, "max": 100}, "dial": false, "identified": true, "inscription": "", "range": "50 ft", "duration": "until released", "targeting": "area", "save": "vs. Eyes", "damage": "", "rarity": "common"}, "effects": [], "folder": null, "sort": 2, "ownership": {"default": 0}, "flags": {}, "_key": "!items!Pb5OgoGW7zPKLldE"}, {"_id": "7BbvAKSoivcD5oFL", "name": "The Eye of Advancing Through Portals", "type": "eye", "img": "icons/svg/eye.svg", "system": {"description": "<p>Opens any door, blasts 10 ft of rock, or bores a 10-ft tunnel. A person struck dies unless he saves.</p><p>When found, the referee rolls d100 for charges; 5% of Eyes are defective (Sec. 1300).</p>", "source": "EPT 1975 Sec. 1310 no. 3", "cost": 0, "weight": 0, "quantity": 1, "charges": {"value": 0, "max": 100}, "dial": false, "identified": true, "inscription": "", "range": "10 ft", "duration": "", "targeting": "aimed", "save": "vs. Eyes", "damage": "", "rarity": ""}, "effects": [], "folder": null, "sort": 3, "ownership": {"default": 0}, "flags": {}, "_key": "!items!7BbvAKSoivcD5oFL"}, {"_id": "VbpAioayaRuV4evu", "name": "The Eye of Aerial Excellence", "type": "eye", "img": "icons/svg/eye.svg", "system": {"description": "<p>User and 1d12 companions fly up to 300 ft a turn.</p><p>When found, the referee rolls d100 for charges; 5% of Eyes are defective (Sec. 1300).</p>", "source": "EPT 1975 Sec. 1310 no. 4", "cost": 0, "weight": 0, "quantity": 1, "charges": {"value": 0, "max": 100}, "dial": false, "identified": true, "inscription": "", "range": "5-ft radius", "duration": "4 turns per charge", "targeting": "none", "save": "unwilling: vs. Eyes", "damage": "", "rarity": ""}, "effects": [], "folder": null, "sort": 4, "ownership": {"default": 0}, "flags": {}, "_key": "!items!VbpAioayaRuV4evu"}, {"_id": "iBAPIe1kNUx6jWHA", "name": "The Eye of Allseeing Wonder", "type": "eye", "img": "icons/svg/eye.svg", "system": {"description": "<p>A one-foot beam reveals invisible objects, beings and dimensional doors; also gives light.</p><p>When found, the referee rolls d100 for charges; 5% of Eyes are defective (Sec. 1300).</p>", "source": "EPT 1975 Sec. 1310 no. 5", "cost": 0, "weight": 0, "quantity": 1, "charges": {"value": 0, "max": 100}, "dial": false, "identified": true, "inscription": "", "range": "120 ft", "duration": "1 turn per charge", "targeting": "none", "save": "", "damage": "", "rarity": ""}, "effects": [], "folder": null, "sort": 5, "ownership": {"default": 0}, "flags": {}, "_key": "!items!iBAPIe1kNUx6jWHA"}, {"_id": "YK9tSQCL2kBCnYdB", "name": "The Eye of Being an Unimpeachable Shield Against Foes", "type": "eye", "img": "icons/svg/eye.svg", "system": {"description": "<p>Up to 1d4 beings are immune to all edged and blunt weapons, magical or not. No protection from spells or devices.</p><p>When found, the referee rolls d100 for charges; 5% of Eyes are defective (Sec. 1300).</p>", "source": "EPT 1975 Sec. 1310 no. 6", "cost": 0, "weight": 0, "quantity": 1, "charges": {"value": 0, "max": 100}, "dial": false, "identified": true, "inscription": "", "range": "", "duration": "2 turns", "targeting": "none", "save": "", "damage": "", "rarity": ""}, "effects": [], "folder": null, "sort": 6, "ownership": {"default": 0}, "flags": {}, "_key": "!items!YK9tSQCL2kBCnYdB"}, {"_id": "ORZoYfmgIOCeMsVh", "name": "The Eye of Bestowing Life", "type": "eye", "img": "icons/svg/eye.svg", "system": {"description": "<p>Revives a being slain within three weeks from any fragment. On 91-100 on d100, no Constitution is lost. Rare; never for sale.</p><p>When found, the referee rolls d100 for charges; 5% of Eyes are defective (Sec. 1300).</p>", "source": "EPT 1975 Sec. 1310 no. 7", "cost": 0, "weight": 0, "quantity": 1, "charges": {"value": 0, "max": 100}, "dial": false, "identified": true, "inscription": "", "range": "", "duration": "", "targeting": "none", "save": "", "damage": "", "rarity": "rare"}, "effects": [], "folder": null, "sort": 7, "ownership": {"default": 0}, "flags": {}, "_key": "!items!ORZoYfmgIOCeMsVh"}, {"_id": "V9KbFtiwjjKI7sXl", "name": "The Eye of Calling Forth an Unconquerable Army", "type": "eye", "img": "icons/svg/eye.svg", "system": {"description": "<p>Up to 1d100 automatons per charge: AC 2, 3+1 HD, move 9, sword and shield. Fighters only.</p><p>When found, the referee rolls d100 for charges; 5% of Eyes are defective (Sec. 1300).</p>", "source": "EPT 1975 Sec. 1310 no. 8", "cost": 0, "weight": 0, "quantity": 1, "charges": {"value": 0, "max": 100}, "dial": false, "identified": true, "inscription": "", "range": "", "duration": "2 turns", "targeting": "none", "save": "", "damage": "", "rarity": ""}, "effects": [], "folder": null, "sort": 8, "ownership": {"default": 0}, "flags": {}, "_key": "!items!V9KbFtiwjjKI7sXl"}, {"_id": "HlVxkZuglbj5UKDr", "name": "The Eye of the Creeping Fog of Doom", "type": "eye", "img": "icons/svg/eye.svg", "system": {"description": "<p>A gas cloud 100 ft square moving 60 ft a turn: 50% nerve gas, 40% contact gas, 10% harmless. Needs 140 ft of open space; watch the wind.</p><p>When found, the referee rolls d100 for charges; 5% of Eyes are defective (Sec. 1300).</p>", "source": "EPT 1975 Sec. 1310 no. 9", "cost": 0, "weight": 0, "quantity": 1, "charges": {"value": 0, "max": 100}, "dial": false, "identified": true, "inscription": "", "range": "", "duration": "4 turns", "targeting": "area", "save": "", "damage": "", "rarity": ""}, "effects": [], "folder": null, "sort": 9, "ownership": {"default": 0}, "flags": {}, "_key": "!items!HlVxkZuglbj5UKDr"}, {"_id": "Ho3bkAQvvi66BILP", "name": "The Eye of Departing in Safety", "type": "eye", "img": "icons/svg/eye.svg", "system": {"description": "<p>Carries the user and 1d12 beings to a preset place. Used without a destination, it carries them into darkness forever.</p><p>When found, the referee rolls d100 for charges; 5% of Eyes are defective (Sec. 1300).</p>", "source": "EPT 1975 Sec. 1310 no. 10", "cost": 0, "weight": 0, "quantity": 1, "charges": {"value": 0, "max": 100}, "dial": false, "identified": true, "inscription": "", "range": "300 ft", "duration": "", "targeting": "none", "save": "", "damage": "", "rarity": ""}, "effects": [], "folder": null, "sort": 10, "ownership": {"default": 0}, "flags": {}, "_key": "!items!Ho3bkAQvvi66BILP"}, {"_id": "B9ERTk2yCf3wifJF", "name": "The Eye of Exquisite Power Over Maidens", "type": "eye", "img": "icons/svg/eye.svg", "system": {"description": "<p>Charms one human of the opposite sex until another charge releases them. Nonhumans unaffected.</p><p>When found, the referee rolls d100 for charges; 5% of Eyes are defective (Sec. 1300).</p>", "source": "EPT 1975 Sec. 1310 no. 11", "cost": 0, "weight": 0, "quantity": 1, "charges": {"value": 0, "max": 100}, "dial": false, "identified": true, "inscription": "", "range": "60 ft", "duration": "until released", "targeting": "aimed", "save": "vs. Eyes", "damage": "", "rarity": ""}, "effects": [], "folder": null, "sort": 11, "ownership": {"default": 0}, "flags": {}, "_key": "!items!B9ERTk2yCf3wifJF"}, {"_id": "jDPMW92k4aX0Udca", "name": "The Eye of Frigid Breath", "type": "eye", "img": "icons/svg/eye.svg", "system": {"description": "<p>Cone of cold: at 30 ft one being, 60 ft 1-6, 100 ft 1d12. A failed save is death. Passes through intervening beings.</p><p>When found, the referee rolls d100 for charges; 5% of Eyes are defective (Sec. 1300).</p>", "source": "EPT 1975 Sec. 1310 no. 12", "cost": 0, "weight": 0, "quantity": 1, "charges": {"value": 0, "max": 100}, "dial": false, "identified": true, "inscription": "", "range": "120 ft", "duration": "", "targeting": "area", "save": "vs. Eyes", "damage": "", "rarity": "common"}, "effects": [], "folder": null, "sort": 12, "ownership": {"default": 0}, "flags": {}, "_key": "!items!jDPMW92k4aX0Udca"}, {"_id": "aNswBTkxukqoHVQ2", "name": "The Eye of Hastening Destiny", "type": "eye", "img": "icons/svg/eye.svg", "system": {"description": "<p>User and 1-6 companions move at triple speed: three blows a round.</p><p>When found, the referee rolls d100 for charges; 5% of Eyes are defective (Sec. 1300).</p>", "source": "EPT 1975 Sec. 1310 no. 13", "cost": 0, "weight": 0, "quantity": 1, "charges": {"value": 0, "max": 100}, "dial": false, "identified": true, "inscription": "", "range": "5-ft radius", "duration": "2 turns", "targeting": "none", "save": "", "damage": "", "rarity": ""}, "effects": [], "folder": null, "sort": 13, "ownership": {"default": 0}, "flags": {}, "_key": "!items!aNswBTkxukqoHVQ2"}, {"_id": "FxUxtZ9k1JOWBVHQ", "name": "The Eye of Illuminating Glory", "type": "eye", "img": "icons/svg/eye.svg", "system": {"description": "<p>Soft light that can be capped and reopened. Does not negate surprise. Common.</p><p>When found, the referee rolls d100 for charges; 5% of Eyes are defective (Sec. 1300).</p>", "source": "EPT 1975 Sec. 1310 no. 14", "cost": 0, "weight": 0, "quantity": 1, "charges": {"value": 0, "max": 100}, "dial": false, "identified": true, "inscription": "", "range": "30 ft", "duration": "10 turns", "targeting": "none", "save": "", "damage": "", "rarity": "common"}, "effects": [], "folder": null, "sort": 14, "ownership": {"default": 0}, "flags": {}, "_key": "!items!FxUxtZ9k1JOWBVHQ"}, {"_id": "iqQt0tcx54DUJQJJ", "name": "The Eye of Incomparable Understanding", "type": "eye", "img": "icons/svg/eye.svg", "system": {"description": "<p>Translates any spoken human or nonhuman language, both ways.</p><p>When found, the referee rolls d100 for charges; 5% of Eyes are defective (Sec. 1300).</p>", "source": "EPT 1975 Sec. 1310 no. 15", "cost": 0, "weight": 0, "quantity": 1, "charges": {"value": 0, "max": 100}, "dial": false, "identified": true, "inscription": "", "range": "30 ft", "duration": "4 turns", "targeting": "none", "save": "", "damage": "", "rarity": ""}, "effects": [], "folder": null, "sort": 15, "ownership": {"default": 0}, "flags": {}, "_key": "!items!iqQt0tcx54DUJQJJ"}, {"_id": "L5aeuSYzWDUFzzTU", "name": "The Eye of Indefinable Apprehension", "type": "eye", "img": "icons/svg/eye.svg", "system": {"description": "<p>Panic: 1d100 beings of levels I-III, 1-6 of IV-VII, one of VIII+. Not automatons, undead or supernatural Underworld creatures.</p><p>When found, the referee rolls d100 for charges; 5% of Eyes are defective (Sec. 1300).</p>", "source": "EPT 1975 Sec. 1310 no. 16", "cost": 0, "weight": 0, "quantity": 1, "charges": {"value": 0, "max": 100}, "dial": false, "identified": true, "inscription": "", "range": "40 ft", "duration": "3 turns", "targeting": "area", "save": "vs. Eyes", "damage": "", "rarity": ""}, "effects": [], "folder": null, "sort": 16, "ownership": {"default": 0}, "flags": {}, "_key": "!items!L5aeuSYzWDUFzzTU"}, {"_id": "B9vPzDLfMmt3dyWc", "name": "The Eye of Insubstantial Visioning", "type": "eye", "img": "icons/svg/eye.svg", "system": {"description": "<p>Illusions believed by humans of levels I-VI 60%, nonhumans I-IV 40%, animals and creatures under 5 HD 70%. Believed damage is real.</p><p>When found, the referee rolls d100 for charges; 5% of Eyes are defective (Sec. 1300).</p>", "source": "EPT 1975 Sec. 1310 no. 17", "cost": 0, "weight": 0, "quantity": 1, "charges": {"value": 0, "max": 100}, "dial": false, "identified": true, "inscription": "", "range": "40 ft", "duration": "2 turns", "targeting": "area", "save": "", "damage": "", "rarity": ""}, "effects": [], "folder": null, "sort": 17, "ownership": {"default": 0}, "flags": {}, "_key": "!items!B9vPzDLfMmt3dyWc"}, {"_id": "nukrWSr0q9VlZtI4", "name": "The Eye of Joyful Sitting Amongst Friends", "type": "eye", "img": "icons/svg/eye.svg", "system": {"description": "<p>1-3 human or nonhuman enemies become devoted friends.</p><p>When found, the referee rolls d100 for charges; 5% of Eyes are defective (Sec. 1300).</p>", "source": "EPT 1975 Sec. 1310 no. 18", "cost": 0, "weight": 0, "quantity": 1, "charges": {"value": 0, "max": 100}, "dial": false, "identified": true, "inscription": "", "range": "20 ft", "duration": "4 turns", "targeting": "area", "save": "vs. Eyes", "damage": "", "rarity": ""}, "effects": [], "folder": null, "sort": 18, "ownership": {"default": 0}, "flags": {}, "_key": "!items!nukrWSr0q9VlZtI4"}, {"_id": "7BrhJGEstnkhGy5z", "name": "The Eye of Madness", "type": "eye", "img": "icons/svg/eye.svg", "system": {"description": "<p>1d12 humans, nonhumans or animals go mad until healed by Heal Serious Wounds or the Ineluctable Eye of Healing.</p><p>When found, the referee rolls d100 for charges; 5% of Eyes are defective (Sec. 1300).</p>", "source": "EPT 1975 Sec. 1310 no. 19", "cost": 0, "weight": 0, "quantity": 1, "charges": {"value": 0, "max": 100}, "dial": false, "identified": true, "inscription": "", "range": "40 ft", "duration": "permanent", "targeting": "area", "save": "vs. Eyes", "damage": "", "rarity": ""}, "effects": [], "folder": null, "sort": 19, "ownership": {"default": 0}, "flags": {}, "_key": "!items!7BrhJGEstnkhGy5z"}, {"_id": "7bVZcW6Uat3cFqTQ", "name": "The Eye of Non-Seeing", "type": "eye", "img": "icons/svg/eye.svg", "system": {"description": "<p>1-6 beings turn invisible and may fight: +3 to saves against aimed devices, +2 to the score needed to hit them.</p><p>When found, the referee rolls d100 for charges; 5% of Eyes are defective (Sec. 1300).</p>", "source": "EPT 1975 Sec. 1310 no. 20", "cost": 0, "weight": 0, "quantity": 1, "charges": {"value": 0, "max": 100}, "dial": false, "identified": true, "inscription": "", "range": "10-ft radius", "duration": "3 turns", "targeting": "none", "save": "", "damage": "", "rarity": ""}, "effects": [], "folder": null, "sort": 20, "ownership": {"default": 0}, "flags": {}, "_key": "!items!7bVZcW6Uat3cFqTQ"}, {"_id": "XDoHtjBQxRM0PQmG", "name": "The Eye of Opening the Way", "type": "eye", "img": "icons/svg/eye.svg", "system": {"description": "<p>Finds and opens secret doors; buzzes within a foot of a trap.</p><p>When found, the referee rolls d100 for charges; 5% of Eyes are defective (Sec. 1300).</p>", "source": "EPT 1975 Sec. 1310 no. 21", "cost": 0, "weight": 0, "quantity": 1, "charges": {"value": 0, "max": 100}, "dial": false, "identified": true, "inscription": "", "range": "20 ft", "duration": "2 turns", "targeting": "none", "save": "", "damage": "", "rarity": ""}, "effects": [], "folder": null, "sort": 21, "ownership": {"default": 0}, "flags": {}, "_key": "!items!XDoHtjBQxRM0PQmG"}, {"_id": "2prLxrjn3SPWb1kT", "name": "The Eye of Raising an Infernal Barrier", "type": "eye", "img": "icons/svg/eye.svg", "system": {"description": "<p>A wall of flame 10 ft high and up to 30 ft wide. Beings 20-30 ft away save to jump clear or take 3d6. Needs 20 ft clear.</p><p>When found, the referee rolls d100 for charges; 5% of Eyes are defective (Sec. 1300).</p>", "source": "EPT 1975 Sec. 1310 no. 22", "cost": 0, "weight": 0, "quantity": 1, "charges": {"value": 0, "max": 100}, "dial": false, "identified": true, "inscription": "", "range": "20 ft ahead", "duration": "2 turns", "targeting": "area", "save": "vs. Eyes", "damage": "3d6", "rarity": ""}, "effects": [], "folder": null, "sort": 22, "ownership": {"default": 0}, "flags": {}, "_key": "!items!2prLxrjn3SPWb1kT"}, {"_id": "E7ZIaVtL8s5iFiqR", "name": "The Eye of Regeneration", "type": "eye", "img": "icons/svg/eye.svg", "system": {"description": "<p>Regrows a lost limb or organ; one charge per limb. Does not raise the dead.</p><p>When found, the referee rolls d100 for charges; 5% of Eyes are defective (Sec. 1300).</p>", "source": "EPT 1975 Sec. 1310 no. 23", "cost": 0, "weight": 0, "quantity": 1, "charges": {"value": 0, "max": 100}, "dial": false, "identified": true, "inscription": "", "range": "", "duration": "2 turns", "targeting": "none", "save": "", "damage": "", "rarity": ""}, "effects": [], "folder": null, "sort": 23, "ownership": {"default": 0}, "flags": {}, "_key": "!items!E7ZIaVtL8s5iFiqR"}, {"_id": "QPid3il1ljSNxfrQ", "name": "The Eye of Retaining All Things", "type": "eye", "img": "icons/svg/eye.svg", "system": {"description": "<p>Stores up to 100,000 Káitars of weight in an airless void; no living beings. Another charge brings things back.</p><p>When found, the referee rolls d100 for charges; 5% of Eyes are defective (Sec. 1300).</p>", "source": "EPT 1975 Sec. 1310 no. 24", "cost": 0, "weight": 0, "quantity": 1, "charges": {"value": 0, "max": 100}, "dial": false, "identified": true, "inscription": "", "range": "", "duration": "", "targeting": "none", "save": "", "damage": "", "rarity": ""}, "effects": [], "folder": null, "sort": 24, "ownership": {"default": 0}, "flags": {}, "_key": "!items!QPid3il1ljSNxfrQ"}, {"_id": "NsI5qTiIyy9xR4ck", "name": "The Eye of Retarding Destiny", "type": "eye", "img": "icons/svg/eye.svg", "system": {"description": "<p>1d12 beings slowed to one-third speed.</p><p>When found, the referee rolls d100 for charges; 5% of Eyes are defective (Sec. 1300).</p>", "source": "EPT 1975 Sec. 1310 no. 25", "cost": 0, "weight": 0, "quantity": 1, "charges": {"value": 0, "max": 100}, "dial": false, "identified": true, "inscription": "", "range": "30 ft", "duration": "2 turns", "targeting": "area", "save": "vs. Eyes", "damage": "", "rarity": ""}, "effects": [], "folder": null, "sort": 25, "ownership": {"default": 0}, "flags": {}, "_key": "!items!NsI5qTiIyy9xR4ck"}, {"_id": "3p3zVVbolE1l1w0O", "name": "The Eye of Returning Unto Darkness", "type": "eye", "img": "icons/svg/eye.svg", "system": {"description": "<p>Total darkness on the user and 1-6 others (+3 to hit them, they cannot fight), or on an enemy group as a weapon.</p><p>When found, the referee rolls d100 for charges; 5% of Eyes are defective (Sec. 1300).</p>", "source": "EPT 1975 Sec. 1310 no. 26", "cost": 0, "weight": 0, "quantity": 1, "charges": {"value": 0, "max": 100}, "dial": false, "identified": true, "inscription": "", "range": "20 ft", "duration": "2 turns", "targeting": "area", "save": "vs. Eyes", "damage": "", "rarity": ""}, "effects": [], "folder": null, "sort": 26, "ownership": {"default": 0}, "flags": {}, "_key": "!items!3p3zVVbolE1l1w0O"}, {"_id": "brzMxYAtyhPfIoGA", "name": "The Eye of Rising Above All", "type": "eye", "img": "icons/svg/eye.svg", "system": {"description": "<p>Rise 240 ft straight up, or lift up to 1,000 lb and tow it.</p><p>When found, the referee rolls d100 for charges; 5% of Eyes are defective (Sec. 1300).</p>", "source": "EPT 1975 Sec. 1310 no. 27", "cost": 0, "weight": 0, "quantity": 1, "charges": {"value": 0, "max": 100}, "dial": false, "identified": true, "inscription": "", "range": "20 ft", "duration": "5 turns", "targeting": "none", "save": "", "damage": "", "rarity": ""}, "effects": [], "folder": null, "sort": 27, "ownership": {"default": 0}, "flags": {}, "_key": "!items!brzMxYAtyhPfIoGA"}, {"_id": "MqwSSqGMqviRJS77", "name": "The Eye of Ruling as a King in Glory", "type": "eye", "img": "icons/svg/eye.svg", "system": {"description": "<p>10-1,000 humans and nonhumans of levels I-II obey the user. Smashing the Eye ends it.</p><p>When found, the referee rolls d100 for charges; 5% of Eyes are defective (Sec. 1300).</p>", "source": "EPT 1975 Sec. 1310 no. 28", "cost": 0, "weight": 0, "quantity": 1, "charges": {"value": 0, "max": 100}, "dial": false, "identified": true, "inscription": "", "range": "120 ft", "duration": "10 turns", "targeting": "area", "save": "vs. Eyes", "damage": "", "rarity": ""}, "effects": [], "folder": null, "sort": 28, "ownership": {"default": 0}, "flags": {}, "_key": "!items!MqwSSqGMqviRJS77"}, {"_id": "GUeopRQSF13tau8P", "name": "The Eye of Strengthening the Majesty of Weapons", "type": "eye", "img": "icons/svg/eye.svg", "system": {"description": "<p>Each charge adds +1 to an edged steel weapon (max +3) or to blunt weapons, armour or shields (max +2).</p><p>When found, the referee rolls d100 for charges; 5% of Eyes are defective (Sec. 1300).</p>", "source": "EPT 1975 Sec. 1310 no. 29", "cost": 0, "weight": 0, "quantity": 1, "charges": {"value": 0, "max": 100}, "dial": false, "identified": true, "inscription": "", "range": "", "duration": "permanent", "targeting": "none", "save": "", "damage": "", "rarity": ""}, "effects": [], "folder": null, "sort": 29, "ownership": {"default": 0}, "flags": {}, "_key": "!items!GUeopRQSF13tau8P"}, {"_id": "CMmsceW9Smx9fzEN", "name": "The Eye of Transformation", "type": "eye", "img": "icons/svg/eye.svg", "system": {"description": "<p>Reverses the alignment of one human or intelligent nonhuman. Undone by another charge.</p><p>When found, the referee rolls d100 for charges; 5% of Eyes are defective (Sec. 1300).</p>", "source": "EPT 1975 Sec. 1310 no. 30", "cost": 0, "weight": 0, "quantity": 1, "charges": {"value": 0, "max": 100}, "dial": false, "identified": true, "inscription": "", "range": "10 ft", "duration": "permanent", "targeting": "aimed", "save": "vs. Eyes", "damage": "", "rarity": ""}, "effects": [], "folder": null, "sort": 30, "ownership": {"default": 0}, "flags": {}, "_key": "!items!CMmsceW9Smx9fzEN"}, {"_id": "yDEI6b4l4Xp8isNS", "name": "The Eye of Triumphant Passage Through Infernos", "type": "eye", "img": "icons/svg/eye.svg", "system": {"description": "<p>User passes unharmed through walls of fire and infernal barriers.</p><p>When found, the referee rolls d100 for charges; 5% of Eyes are defective (Sec. 1300).</p>", "source": "EPT 1975 Sec. 1310 no. 31", "cost": 0, "weight": 0, "quantity": 1, "charges": {"value": 0, "max": 100}, "dial": false, "identified": true, "inscription": "", "range": "self", "duration": "2 turns", "targeting": "none", "save": "", "damage": "", "rarity": ""}, "effects": [], "folder": null, "sort": 31, "ownership": {"default": 0}, "flags": {}, "_key": "!items!yDEI6b4l4Xp8isNS"}, {"_id": "FU7FFibWco84qqbW", "name": "The Incomparable Eye of Command", "type": "eye", "img": "icons/svg/eye.svg", "system": {"description": "<p>Controls 1d12 beings, who obey without will.</p><p>When found, the referee rolls d100 for charges; 5% of Eyes are defective (Sec. 1300).</p>", "source": "EPT 1975 Sec. 1310 no. 32", "cost": 0, "weight": 0, "quantity": 1, "charges": {"value": 0, "max": 100}, "dial": false, "identified": true, "inscription": "", "range": "30 ft", "duration": "2 turns", "targeting": "area", "save": "16+ (I-IV), 13+ (V-VIII), 10+ (IX+)", "damage": "", "rarity": ""}, "effects": [], "folder": null, "sort": 32, "ownership": {"default": 0}, "flags": {}, "_key": "!items!FU7FFibWco84qqbW"}, {"_id": "DsWdXKsg8nu3CAPz", "name": "The Ineluctable Eye of Healing", "type": "eye", "img": "icons/svg/eye.svg", "system": {"description": "<p>Cures disease and heals 2d6 per charge, one being per charge. Used first, it replaces a save against disease or poison.</p><p>When found, the referee rolls d100 for charges; 5% of Eyes are defective (Sec. 1300).</p>", "source": "EPT 1975 Sec. 1310 no. 33", "cost": 0, "weight": 0, "quantity": 1, "charges": {"value": 0, "max": 100}, "dial": false, "identified": true, "inscription": "", "range": "10 ft", "duration": "", "targeting": "none", "save": "", "damage": "2d6", "rarity": ""}, "effects": [], "folder": null, "sort": 33, "ownership": {"default": 0}, "flags": {}, "_key": "!items!DsWdXKsg8nu3CAPz"}, {"_id": "5xYUTlUpVidQb00Q", "name": "The Splendid Eye of Krá the Mighty", "type": "eye", "img": "icons/svg/eye.svg", "system": {"description": "<p>Pulls or pushes up to 1,000 lb or walls 3 ft thick; as a weapon 4d6 within arm's reach (save to dodge).</p><p>When found, the referee rolls d100 for charges; 5% of Eyes are defective (Sec. 1300).</p>", "source": "EPT 1975 Sec. 1310 no. 34", "cost": 0, "weight": 0, "quantity": 1, "charges": {"value": 0, "max": 100}, "dial": false, "identified": true, "inscription": "", "range": "arm's reach / 5 ft", "duration": "", "targeting": "aimed", "save": "vs. Eyes", "damage": "4d6", "rarity": ""}, "effects": [], "folder": null, "sort": 34, "ownership": {"default": 0}, "flags": {}, "_key": "!items!5xYUTlUpVidQb00Q"}, {"_id": "S3wJxGz8eRblK30k", "name": "The Terrible Eye of Raging Power", "type": "eye", "img": "icons/svg/eye.svg", "system": {"description": "<p>Lightning in a 10-ft circle hits 1-10 beings in the first three ranks for 4d6. Needs 100 ft or rebounds on the user.</p><p>When found, the referee rolls d100 for charges; 5% of Eyes are defective (Sec. 1300).</p>", "source": "EPT 1975 Sec. 1310 no. 35", "cost": 0, "weight": 0, "quantity": 1, "charges": {"value": 0, "max": 100}, "dial": false, "identified": true, "inscription": "", "range": "100 ft", "duration": "", "targeting": "area", "save": "vs. Eyes", "damage": "4d6", "rarity": ""}, "effects": [], "folder": null, "sort": 35, "ownership": {"default": 0}, "flags": {}, "_key": "!items!S3wJxGz8eRblK30k"}, {"_id": "A2Tz3vamO5jrkVJG", "name": "The Thoroughly Useful Eye", "type": "eye", "img": "icons/svg/eye.svg", "system": {"description": "<p>Recharges another Eye by one charge a day; never needs recharging itself. Rarest of all; never for sale.</p><p>When found, the 